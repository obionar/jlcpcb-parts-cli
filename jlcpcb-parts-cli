# CLI

CACHE_DIR = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "jlcpcb-parts-cli"

TIER_LABELS = {
    TIER_BASIC: "BASIC",
    TIER_PROMO: "PROMO-EXT",
    TIER_EXTENDED: "EXT",
}
TIER_ALIASES = {
    "basic": TIER_BASIC,
    "promo": TIER_PROMO,
    "promo_extended": TIER_PROMO,
    "extended": TIER_EXTENDED,
    "any": None,
}


def fmt_price(p: float | None) -> str:
    return f"${p:.4f}" if p is not None else "-"


def positive_int(value: str) -> int:
    parsed = int(value)
    if parsed <= 0:
        raise argparse.ArgumentTypeError("must be greater than zero")
    return parsed


def non_negative_int(value: str) -> int:
    parsed = int(value)
    if parsed < 0:
        raise argparse.ArgumentTypeError("must be zero or greater")
    return parsed


def positive_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed) or parsed <= 0:
        raise argparse.ArgumentTypeError("must be a finite value greater than zero")
    return parsed


def _show_warnings() -> None:
    for warning in take_warnings():
        print(f"warning: {warning}", file=sys.stderr)


def print_table(parts: list[dict], as_json: bool) -> None:
    if as_json:
        print(json.dumps(parts, indent=2, ensure_ascii=False))
        return
    if not parts:
        print("No results.")
        return
    print(f"{'TIER':<10}{'CODE':<10}{'MPN':<32}{'PKG':<18}{'STOCK':>10}  {'PRICE@1':<9} DESCRIPTION")
    for p in parts:
        desc = (p["description"] or "")[:60]
        print(f"{TIER_LABELS.get(p['tier'], p['tier']):<10}{p['code'] or '-':<10}"
              f"{(p['mpn'] or '-')[:31]:<32}{(p['package'] or '-')[:17]:<18}"
              f"{p['stock']:>10}  {fmt_price(p['price_1']):<9} {desc}")
    print(f"\n{len(parts)} part(s). Priority: BASIC -> PROMO-EXT -> EXT")


def cmd_search(args: argparse.Namespace) -> int:
    tier = TIER_ALIASES[args.tier]
    base_only = tier in {TIER_BASIC, TIER_PROMO}
    page_size = min(max(args.limit * 3, 50), 100)
    parts: list[dict[str, Any]] = []
    total = 0
    for page in range(1, SEARCH_MAX_PAGES + 1):
        total, raw_page_parts = search(
            args.keyword,
            base_only=base_only,
            page_size=page_size,
            page=page,
        )
        page_parts = raw_page_parts
        if tier:
            page_parts = [part for part in page_parts if part["tier"] == tier]
        if args.min_stock:
            page_parts = [part for part in page_parts if part["stock"] >= args.min_stock]
        parts.extend(page_parts)
        if len(parts) >= args.limit or page * page_size >= total or not raw_page_parts:
            break
    parts.sort(key=sort_key)
    parts = parts[: args.limit]
    if not args.json:
        print(f"API total: {total}")
    print_table(parts, args.json)
    return 0


def _valid_cached_part(part: Any) -> bool:
    if not isinstance(part, dict):
        return False
    required = {
        "code", "mpn", "description", "manufacturer", "package", "category",
        "stock", "tier", "price_1", "url", "datasheet",
    }
    if not required.issubset(part):
        return False
    text_fields = {
        "code", "mpn", "description", "manufacturer", "package", "category",
        "url", "datasheet",
    }
    if any(
        part[field] is not None and not isinstance(part[field], str)
        for field in text_fields
    ):
        return False
    if part["tier"] not in _TIER_ORDER or isinstance(part["stock"], bool):
        return False
    if not isinstance(part["stock"], int) or part["stock"] < 0:
        return False
    price = part["price_1"]
    return price is None or (
        isinstance(price, (int, float))
        and not isinstance(price, bool)
        and math.isfinite(price)
        and price >= 0
    )


def _atomic_write_text(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, tmp_name = tempfile.mkstemp(
        prefix=f".{path.name}.", suffix=".tmp", dir=path.parent
    )
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as tmp_file:
            tmp_file.write(text)
            tmp_file.flush()
            os.fsync(tmp_file.fileno())
        os.replace(tmp_name, path)
    except BaseException:
        try:
            os.unlink(tmp_name)
        except FileNotFoundError:
            pass
        raise


def load_basic_cache(refresh: bool) -> tuple[list[dict], str]:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    cache = CACHE_DIR / "basic_parts.json"
    if cache.exists() and not refresh:
        try:
            age_h = (time.time() - cache.stat().st_mtime) / 3600
            if age_h < 24:
                data = json.loads(cache.read_text())
                parts = data["parts"]
                if not isinstance(parts, list) or any(
                    not _valid_cached_part(part) for part in parts
                ):
                    raise ValueError("cache contains invalid parts")
                return parts, f"cache ({age_h:.1f}h old; --refresh to update)"
        except (json.JSONDecodeError, KeyError, TypeError, ValueError, OSError):
            # Corrupted or wrong-shape cache: fall through to a refetch.
            pass
    parts = list(iter_all(base_only=True))
    if any(not _valid_cached_part(part) for part in parts):
        raise PayloadError("JLCPCB normalized part data failed cache validation")
    _atomic_write_text(
        cache, json.dumps({"fetched": time.time(), "parts": parts}, allow_nan=False)
    )
    return parts, "fresh from API"


def cmd_basic(args: argparse.Namespace) -> int:
    parts, source = load_basic_cache(args.refresh)
    if args.list_categories:
        counts = Counter(p["category"] or "-" for p in parts)
        if not args.json:
            print(f"Categories in Basic & Promotional pool — {source}")
            for cat, n in sorted(counts.items(), key=lambda kv: (-kv[1], kv[0])):
                print(f"{n:>6}  {cat}")
        else:
            print(json.dumps(dict(sorted(counts.items(),
                                         key=lambda kv: -kv[1])),
                             indent=2, ensure_ascii=False))
        return 0
    if args.category:
        cat = args.category.lower()
        parts = [p for p in parts if cat in (p["category"] or "").lower()]
        if not parts and not args.json:
            print(f"No category matching {args.category!r}. "
                  "Try: --list-categories")
    parts.sort(key=sort_key)
    parts = parts[: args.limit]
    if not args.json:
        print(f"Basic & Promotional Extended pool — {source}")
    print_table(parts, args.json)
    return 0


def cmd_info(args: argparse.Namespace) -> int:
    ident = args.part
    _, parts = search(ident, page_size=100)
    normalized_ident = ident.strip().casefold()
    picks = [
        p
        for p in parts
        if (p["code"] or "").strip().casefold() == normalized_ident
        or (p["mpn"] or "").strip().casefold() == normalized_ident
    ]
    if not picks:
        if args.json:
            print("[]")
        else:
            print(f"No exact match for {ident!r}.")
        return 1
    if args.json:
        print(json.dumps(picks, indent=2, ensure_ascii=False))
        return 0
    for p in picks:
        print(f"Part:      {p['mpn']}  ({p['code']})")
        print(f"Tier:      {TIER_LABELS.get(p['tier'], p['tier'])}")
        print(f"Manufacturer: {p['manufacturer']}   Package: {p['package']}")
        print(f"Category:  {p['category']}")
        print(f"Stock:     {p['stock']}   Price@1: {fmt_price(p['price_1'])}")
        print(f"URL:       {p['url']}")
        if p["datasheet"]:
            print(f"Datasheet: {p['datasheet']}")
        if p["description"]:
            print(f"Specs:     {p['description'][:200]}")
        print()
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    """Canary probe: known parts + schema sanity. Exit 0/1/2 = PASS/WARN/FAIL."""
    status, checks = run_canaries(timeout=args.timeout)
    icon = {"PASS": "OK", "WARN": "WARN", "FAIL": "FAIL"}[status]
    if args.json:
        print(json.dumps({"status": status, "checks": checks},
                         indent=2, ensure_ascii=False))
    else:
        print(f"JLCPCB API canary: {icon}")
        for c in checks:
            line = f"  [{'ok' if c['ok'] else 'BROKEN'}] {c['name']}"
            print(line)
            if c.get("warn"):
                print(f"         warning: {c['warn']}")
            if c.get("error"):
                print(f"         error: {c['error']}")
        if status != "PASS":
            print("\nAction: verify manually on https://jlcpcb.com/parts; "
                  "if the site works but this fails, the API/schema drifted — "
                  "update the client and its fixtures.")
    return {"PASS": 0, "WARN": 1, "FAIL": 2}[status]


def _md(text: str | None) -> str:
    """Sanitize a field for a Markdown table cell."""
    return " ".join((text or "-").replace("|", "/").split())


def cmd_export(args: argparse.Namespace) -> int:
    """Export the Basic & Promotional pool to a Markdown reference file."""
    parts, source = load_basic_cache(args.refresh)
    parts.sort(key=lambda p: ((p["category"] or "").lower(), sort_key(p)))
    lines = [
        "# JLCPCB Basic & Promotional Extended Parts — offline reference",
        "",
        f"Exported: {time.strftime('%Y-%m-%d %H:%M %Z')} · {len(parts)} parts · {source}.",
        "",
        "Regenerate with: `jlcpcb-parts-cli export --refresh > path.md`",
        "",
        "Tier legend: BASIC = no extra placement fee · PROMO-EXT = no feeder fee "
        "in Economic PCBA · EXT shown only for context.",
        "",
    ]
    current_cat = None
    for p in parts:
        cat = _md(p["category"] or "Uncategorized")
        if cat != current_cat:
            current_cat = cat
            n = sum(1 for q in parts if (q["category"] or "Uncategorized") == cat)
            lines += [f"## {cat} ({n})", "",
                      "| Tier | Code | MPN | Package | Stock | Price@1 | Specs |",
                      "|---|---|---|---|---|---|---|"]
        desc = _md(p["description"])
        lines.append(
            f"| {TIER_LABELS.get(p['tier'], p['tier'])} "
            f"| {p['code']} | {_md(p['mpn'])} | {_md(p['package'])} "
            f"| {p['stock']:,} | {fmt_price(p['price_1'])} | {desc} |"
        )
    text = "\n".join(lines) + "\n"
    out = Path(args.output) if args.output else None
    if out:
        _atomic_write_text(out, text)
        print(f"Wrote {out} ({len(parts)} parts)")
    else:
        sys.stdout.write(text)
    return 0


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="jlcpcb-parts-cli",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("search", help="free-text search across all parts")
    s.add_argument("keyword")
    s.add_argument("--tier", choices=["basic", "promo", "extended", "any"], default="any")
    s.add_argument("--min-stock", type=non_negative_int, default=0)
    s.add_argument("-n", "--limit", type=positive_int, default=15)
    s.set_defaults(func=cmd_search)

    b = sub.add_parser("basic", help="browse Basic & Promotional Extended pool")
    b.add_argument("--category", help="substring of category, e.g. 'regulator'")
    b.add_argument("--list-categories", action="store_true",
                   help="list categories present in the pool and exit")
    b.add_argument("-n", "--limit", type=positive_int, default=20)
    b.add_argument("--refresh", action="store_true")
    b.set_defaults(func=cmd_basic)

    i = sub.add_parser("info", help="detail for a C-code or MPN")
    i.add_argument("part")
    i.set_defaults(func=cmd_info)

    c = sub.add_parser("check", help="canary probe for API/schema drift")
    c.add_argument("--timeout", type=positive_float, default=30.0)
    c.set_defaults(func=cmd_check)

    e = sub.add_parser("export", help="dump Basic & Promo pool to Markdown")
    e.add_argument("-o", "--output", help="output .md path (default: stdout)")
    e.add_argument("--refresh", action="store_true")
    e.set_defaults(func=cmd_export)

    args = ap.parse_args(argv)
    take_warnings()
    try:
        result = args.func(args)
        _show_warnings()
        return result
    except BrokenPipeError:
        return 0
    except (ApiError, OSError, UnicodeError, ValueError) as exc:
        _show_warnings()
        print(f"error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
