#!/usr/bin/env python3
"""jlcpcb-parts-cli — read-only JLCPCB component search, Basic-parts-first.

Single-file CLI, Python 3.10+ standard library only. Copy it anywhere on PATH
(e.g. ~/.local/bin) and it just works. Unofficial: it calls the same public
JSON endpoint the jlcpcb.com parts pages use. No login, no cart, no ordering.

Subcommands:
  search <keyword> [--tier basic|promo|extended|any] [--min-stock N] [-n N]
  basic  [--category X] [--list-categories] [-n N] [--refresh]
  info   <C-code or MPN>
  check  (canary probe for API/schema drift; exit 0/1/2 = PASS/WARN/FAIL)
  export [-o out.md] [--refresh]

This file is part of jlcpcb-parts-cli. Licensed under GPLv3; see LICENSE
or <https://www.gnu.org/licenses/gpl-3.0.txt>.
"""

from __future__ import annotations

import argparse
from collections import Counter
import json
import math
import os
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any, Iterator

VERSION = "1.1.0"

# ---------------------------------------------------------------------------
# Client: read-only access to JLCPCB's unofficial parts-search API.
# Payloads are treated as volatile: missing fields degrade to None, never
# crash. Schema-level anomalies raise PayloadError with a clear message;
# soft anomalies are collected in `last_warnings` for callers to surface.

API_URL = (
    "https://jlcpcb.com/api/overseas-pcb-order/v1/shoppingCart/"
    "smtGood/selectSmtComponentList"
)

TIER_BASIC = "basic"
TIER_PROMO = "promo_extended"
TIER_EXTENDED = "extended"

_TIER_ORDER = {TIER_BASIC: 0, TIER_PROMO: 1, TIER_EXTENDED: 2}

# Retry policy for transient failures.
MAX_ATTEMPTS = 3
RETRY_BACKOFF_S = 2.0
MAX_RESPONSE_BYTES = 20 * 1024 * 1024
SEARCH_MAX_PAGES = 5

# Warnings from the most recent API call(s). Callers should surface these:
# they mean the API responded but something looked off (possible drift).
last_warnings: list[str] = []


def _warn(message: str) -> None:
    if message not in last_warnings:
        last_warnings.append(message)


def take_warnings() -> list[str]:
    """Return and clear accumulated anomaly warnings."""
    out, last_warnings[:] = list(last_warnings), []
    return out


class ApiError(RuntimeError):
    """Raised when the API is unusable. Subclasses tell you why."""


class NetworkError(ApiError):
    """Connectivity / HTTP-level failure — usually transient."""


class PayloadError(ApiError):
    """API responded but the payload is not what we expect — likely schema change."""


class HttpError(ApiError):
    """A non-transient HTTP failure that should not be retried."""


def _text(value: Any) -> str | None:
    """Normalize remote display fields and strip terminal control characters."""
    if value is None:
        return None
    raw = value if isinstance(value, str) else str(value)
    return "".join(
        char if ord(char) >= 32 and not 127 <= ord(char) <= 159 else " "
        for char in raw
    )


def classify_tier(component: dict[str, Any]) -> str:
    """Map a raw component record to basic / promo_extended / extended."""
    lib = component.get("componentLibraryType")
    if lib == "base":
        return TIER_BASIC
    if lib == "expand" and component.get("preferredComponentFlag") is True:
        return TIER_PROMO
    if lib not in ("base", "expand"):
        _warn(f"unknown componentLibraryType {lib!r} on "
              f"{component.get('componentCode')!r}; treated as extended")
    return TIER_EXTENDED


def _first_price(tiers: Any) -> float | None:
    if not isinstance(tiers, list) or not tiers:
        return None
    valid: list[tuple[float, float]] = []
    for tier in tiers:
        if not isinstance(tier, dict):
            continue
        try:
            start = float(tier.get("startNumber", 1))
            price = float(tier["productPrice"])
        except (KeyError, TypeError, ValueError, OverflowError):
            continue
        if math.isfinite(start) and math.isfinite(price) and start >= 0 and price >= 0:
            valid.append((start, price))
    if not valid:
        return None
    return min(valid, key=lambda item: (0 if item[0] <= 1 else 1, item[0]))[1]


def normalize(component: dict[str, Any]) -> dict[str, Any]:
    """Project a raw API record onto the stable public shape."""
    prices = component.get("componentPrices") or component.get("buyComponentPrices")
    datasheet = component.get("dataManualUrl")
    suffix = component.get("urlSuffix")
    url = f"https://jlcpcb.com/partdetail/{_text(suffix)}" if suffix else None
    code = component.get("componentCode")
    # Soft schema checks: fields every real record has carried so far.
    if not code:
        _warn("record without componentCode; possibly changed schema")
    elif not component.get("componentModelEn") and not component.get("componentNameEn"):
        _warn(f"{code}: no MPN field (componentModelEn/componentNameEn missing)")
    stock_raw = component.get("stockCount")
    try:
        if isinstance(stock_raw, bool):
            raise ValueError("boolean stock")
        stock = int(stock_raw) if stock_raw is not None else 0
    except (TypeError, ValueError):
        _warn(f"{code or '?'}: non-numeric stockCount {stock_raw!r}")
        stock = 0
    if stock < 0:
        _warn(f"{code or '?'}: negative stockCount {stock}")
        stock = 0
    return {
        "code": _text(code),
        "mpn": _text(component.get("componentModelEn") or component.get("componentNameEn")),
        "description": _text(component.get("describe") or component.get("componentName")),
        "manufacturer": _text(component.get("componentBrandEn")),
        "package": _text(component.get("componentSpecificationEn")),
        "category": _text(component.get("componentTypeEn")),
        "stock": stock,
        "tier": classify_tier(component),
        "price_1": _first_price(prices),
        "url": url,
        "datasheet": _text(datasheet),
    }


def _request_once(body: dict[str, Any], timeout: float) -> dict[str, Any]:
    data = json.dumps(body).encode()
    req = urllib.request.Request(
        API_URL,
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body_bytes = resp.read(MAX_RESPONSE_BYTES + 1)
            if len(body_bytes) > MAX_RESPONSE_BYTES:
                raise PayloadError("JLCPCB API response is too large.")
            payload = json.loads(body_bytes)
    except urllib.error.HTTPError as exc:
        message = f"JLCPCB API returned HTTP {exc.code}"
        if exc.code in {408, 429} or 500 <= exc.code <= 599:
            raise NetworkError(f"{message}; retry later.") from exc
        raise HttpError(f"{message}; check https://jlcpcb.com/parts.") from exc
    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
        raise PayloadError(
            "JLCPCB API returned non-JSON content — endpoint may have moved. "
            "Check https://jlcpcb.com/parts."
        ) from exc
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise NetworkError(
            f"JLCPCB API request failed ({exc}). "
            "Check connectivity, or browse https://jlcpcb.com/parts directly."
        ) from exc
    if not isinstance(payload, dict) or payload.get("code") != 200:
        raise PayloadError(
            f"JLCPCB API returned unexpected payload "
            f"(code={payload.get('code') if isinstance(payload, dict) else type(payload).__name__}). "
            "The API may have changed; check https://jlcpcb.com/parts."
        )
    info = payload.get("data")
    if not isinstance(info, dict) or not isinstance(info.get("componentPageInfo"), dict):
        raise PayloadError(
            "JLCPCB API response is missing data.componentPageInfo — "
            "schema appears changed; check https://jlcpcb.com/parts."
        )
    page_info = info["componentPageInfo"]
    items = page_info.get("list")
    if items is None:
        # Known quirk: keyword with zero hits returns list=null. Empty is fine;
        # anything else suspicious gets flagged by callers via totals.
        items = []
    if not isinstance(items, list):
        raise PayloadError(
            "JLCPCB API 'list' field is not an array — schema appears changed."
        )
    if any(not isinstance(item, dict) for item in items):
        raise PayloadError(
            "JLCPCB API 'list' contains a non-object record — schema appears changed."
        )
    total_raw = page_info.get("total", 0)
    try:
        total = int(total_raw)
    except (TypeError, ValueError):
        _warn(f"non-numeric result total {total_raw!r}")
        total = 0
    return {"total": max(total, 0), "list": items}


def _request(body: dict[str, Any], timeout: float = 30.0) -> dict[str, Any]:
    """Request with retry/backoff on transient (network) failures only."""
    last_exc: Exception | None = None
    for attempt in range(1, MAX_ATTEMPTS + 1):
        try:
            return _request_once(body, timeout)
        except NetworkError as exc:
            last_exc = exc
            if attempt < MAX_ATTEMPTS:
                time.sleep(RETRY_BACKOFF_S * attempt)
    raise NetworkError(str(last_exc)) from last_exc


def search(
    keyword: str = "",
    *,
    base_only: bool = False,
    basic_only: bool = False,
    page_size: int = 50,
    page: int = 1,
    timeout: float = 30.0,
) -> tuple[int, list[dict[str, Any]]]:
    """One API query. Returns (total, list of normalized parts)."""
    if page_size <= 0 or page <= 0 or timeout <= 0:
        raise ValueError("page_size, page, and timeout must be greater than zero")
    body: dict[str, Any] = {
        "keyword": keyword,
        "pageSize": min(page_size, 100),
        "currentPage": page,
    }
    if base_only or basic_only:
        body["componentLibraryType"] = "base"
        # Required to get the full Basic+Promotional pool (1586); without it the
        # API currently returns only the plain-Basic subset (351).
        body["preferredComponentFlag"] = True
    if basic_only:
        body["componentProductType"] = 1
    res = _request(body, timeout=timeout)
    return res["total"], [normalize(c) for c in res["list"]]


def iter_all(
    keyword: str = "",
    *,
    base_only: bool = False,
    basic_only: bool = False,
    page_size: int = 100,
    timeout: float = 30.0,
) -> Iterator[dict[str, Any]]:
    """Yield all matching normalized parts, paging automatically."""
    page = 1
    while True:
        total, items = search(
            keyword,
            base_only=base_only,
            basic_only=basic_only,
            page_size=page_size,
            page=page,
            timeout=timeout,
        )
        yield from items
        if page * page_size >= total or not items:
            return
        page += 1


def sort_key(part: dict[str, Any]):
    """Default ordering: tier priority, then stock desc."""
    return (_TIER_ORDER.get(part["tier"], 9), -part["stock"])


# Canary check: known-answer probes against live API drift.

# (query, expected_code, expected_tier, min_stock) — verified 2026-08-22.
CANARIES = [
    ("STM32F103C8T6", "C8734", TIER_PROMO, 100),
    ("AMS1117-3.3", "C6186", TIER_BASIC, 1000),
]


def run_canaries(timeout: float = 30.0) -> tuple[str, list[dict[str, Any]]]:
    """Probe known parts and classify overall health.

    Returns (status, checks) where status is PASS / WARN / FAIL and each check
    is {name, ok, warn?, error?}.
    """
    checks: list[dict[str, Any]] = []
    for keyword, code, tier, min_stock in CANARIES:
        name = f"{keyword} → {code}"
        try:
            take_warnings()
            total, parts = search(keyword, page_size=10, timeout=timeout)
            warnings = take_warnings()
        except ApiError as exc:
            checks.append({"name": name, "ok": False, "error": str(exc)})
            continue
        match = next((p for p in parts if p["code"] == code), None)
        if match is None:
            checks.append({
                "name": name, "ok": False,
                "error": f"expected part {code} not in top results "
                         f"(API returned {total} hits)",
            })
            continue
        problems = list(warnings)
        if match["tier"] != tier:
            problems.append(f"tier changed: expected {tier}, got {match['tier']}")
        if match["stock"] < min_stock:
            problems.append(f"stock dropped below {min_stock}: {match['stock']}")
        checks.append({"name": name, "ok": True,
                       **({"warn": "; ".join(problems)} if problems else {})})
    if any(not c["ok"] for c in checks):
        status = "FAIL"
    elif any(c.get("warn") for c in checks):
        status = "WARN"
    else:
        status = "PASS"
    return status, checks


